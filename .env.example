# Pollinations AI server configuration
# Create a key at https://enter.pollinations.ai/keys, then copy this file to .env.
# Keep the key server-side; do not rename it with a VITE_ prefix.
POLLINATIONS_API_KEY=replace-with-your-pollinations-api-key
# Default model pool (each agent gets one stable, randomly selected model):
# openai/gpt-6-luna,nvidia/nemotron-3.5-lightning,minimax/minimax-m3,deepseek/deepseek-v4.1-flash,mistralai/mistral-large-3
# Optional: replace the pool with your own comma-separated model IDs.
# POLLINATIONS_MODELS=openai/gpt-6-luna,nvidia/nemotron-3.5-lightning
# Optional: pin every agent to one model instead of drawing from the pool.
# POLLINATIONS_MODEL=deepseek/deepseek-v4.1-flash
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
# Optional request timeout in milliseconds (default: 25000)
# POLLINATIONS_TIMEOUT_MS=25000
